local leftHand = "qwertasdfgzxcvb"
local rightHand = "yuiophjklnm"

local function getPatternMultiplier(word, position)
    local current = word:sub(position, position)
    local nextChar = word:sub(position + 1, position + 1)
    local prevChar = position > 1 and word:sub(position - 1, position - 1) or nil
    
    local bigram = current .. nextChar
    for _, fb in ipairs(fastBigrams) do
        if bigram == fb then
            return 0.70
        end
    end
    
    if current == nextChar then
        return 1.12
    end
    
    if prevChar and ((leftHand:find(prevChar) and leftHand:find(current)) or (rightHand:find(prevChar) and rightHand:find(current))) then
        return 0.92
    end
    
    if prevChar and ((leftHand:find(prevChar) and rightHand:find(current)) or (rightHand:find(prevChar) and leftHand:find(current))) then
        return 0.80
    end
    
    return 1.0
end

local function getKeyDistanceWeight(currentKey, nextKey)
    if not currentKey or not nextKey then return 1.0 end
    
    local row = {
        ['q']=1,['w']=1,['e']=1,['r']=1,['t']=1,['y']=1,['u']=1,['i']=1,['o']=1,['p']=1,
        ['a']=2,['s']=2,['d']=2,['f']=2,['g']=2,['h']=2,['j']=2,['k']=2,['l']=2,
        ['z']=3,['x']=3,['c']=3,['v']=3,['b']=3,['n']=3,['m']=3,
    }
    
    local currentRow = row[currentKey] or 2
    local nextRow = row[nextKey] or 2
    
    if currentRow == nextRow then
        return 0.85 + math.random() * 0.25
    else
        return 1.05 + math.random() * 0.35
    end
end

local function getWordLengthCategory(len)
    if len <= 3 then return 1 elseif len <= 4 then return 2 elseif len <= 5 then return 3
    elseif len <= 6 then return 4 elseif len <= 7 then return 5 elseif len <= 8 then return 6
    elseif len <= 9 then return 7 elseif len <= 10 then return 8 else return 9 end
end

local function getNeighbor(letter)
    local neighbors = NEIGHBORS[letter]
    if neighbors and #neighbors > 0 then return neighbors[math.random(1, #neighbors)] end
    return letter
end

local function shouldMakeTypo(word)
    local len = #word
    local lenCat = getWordLengthCategory(len)
    local modifier = TYPO_CONFIG.lengthModifier[lenCat] or 1.0
    local finalChance = math.min(0.45, TYPO_CONFIG.typoChancePerWord * modifier)
    return math.random() < finalChance
end

local function generateTypo(word)
    local len = #word
    if len <= 1 then return word end
    
    local roll = math.random()
    local typoType = "singleNeighbor"
    local cumulative = 0
    for typo, odds in pairs(TYPO_CONFIG.typoOdds) do
        cumulative = cumulative + odds
        if roll <= cumulative then typoType = typo break end
    end
    
    local pos = math.random(1, len)
    
    if typoType == "singleNeighbor" then
        local original = word:sub(pos, pos)
        local wrong = getNeighbor(original)
        if wrong and wrong ~= original then
            return word:sub(1, pos-1) .. wrong .. word:sub(pos+1)
        end
    elseif typoType == "doublePress" and len >= 2 then
        local original = word:sub(pos, pos)
        local neighbor = getNeighbor(original)
        if neighbor and neighbor ~= original then
            if math.random() < 0.5 then
                return word:sub(1, pos-1) .. original .. neighbor .. word:sub(pos+1)
            else
                return word:sub(1, pos-1) .. neighbor .. original .. word:sub(pos+1)
            end
        end
    elseif typoType == "omission" and len >= 2 then
        return word:sub(1, pos-1) .. word:sub(pos+1)
    elseif typoType == "repetition" and len <= 10 then
        local repeatLetter = word:sub(pos, pos)
        if pos == len then return word .. repeatLetter
        else return word:sub(1, pos) .. repeatLetter .. word:sub(pos+1) end
    elseif typoType == "transposition" and len >= 2 and pos < len then
        return word:sub(1, pos-1) .. word:sub(pos+1, pos+1) .. word:sub(pos, pos) .. word:sub(pos+2)
    end
    return word
end

local function typeWordWithTypos(word)
    local shouldTypo = shouldMakeTypo(word)
    local typedWord = word
    local hadTypo = false
    
    if shouldTypo then
        typedWord = generateTypo(word)
        hadTypo = typedWord ~= word
    end
    
    local len = #word
    local baseDelay = TYPO_CONFIG.baseDelay
    
    if len > 7 then
        baseDelay = baseDelay + (len - 7) * 0.002
    end
    
    local lastKey = nil
    for i = 1, #typedWord do
        local c = typedWord:sub(i, i)
        if keys[c] then
            local patternMult = getPatternMultiplier(typedWord, i)
            local distanceWeight = getKeyDistanceWeight(lastKey, c)
            local variation = TYPO_CONFIG.consistency + (math.random() * (1 - TYPO_CONFIG.consistency) * 2)
            variation = math.max(0.6, math.min(1.4, variation))
            
            local hesitation = 0
            if math.random() < 0.025 then
                hesitation = 0.04 + math.random() * 0.08
            end
            
            local delay = baseDelay * patternMult * distanceWeight * variation + hesitation
            delay = math.max(0.035, math.min(0.14, delay))
            
            safeKeypress(keys[c])
            task.wait(delay + (math.random() * 0.015))
            safeKeyrelease(keys[c])
            task.wait(0.005 + math.random() * 0.01)
            
            lastKey = c
        end
    end
    
    if hadTypo then
        local typoScenario = math.random()
        
        local reactionDelay = 0
        local backspaceCount = 0
        local pauseBeforeRetype = 0
        
        if typoScenario < 0.35 then
            reactionDelay = 0.04 + math.random() * 0.06
            backspaceCount = 1
            pauseBeforeRetype = 0.02 + math.random() * 0.04
        elseif typoScenario < 0.65 then
            reactionDelay = 0.08 + math.random() * 0.1
            backspaceCount = 1 + (math.random() < 0.3 and 1 or 0)
            pauseBeforeRetype = 0.03 + math.random() * 0.05
        elseif typoScenario < 0.85 then
            local extraLetters = math.random(1, math.min(2, #typedWord - 1))
            reactionDelay = 0.12 + math.random() * 0.15
            backspaceCount = extraLetters + 1
            pauseBeforeRetype = 0.04 + math.random() * 0.06
        else
            reactionDelay = 0.25 + math.random() * 0.25
            backspaceCount = #typedWord
            pauseBeforeRetype = 0.06 + math.random() * 0.08
        end
        
        task.wait(reactionDelay)
        
        for i = 1, backspaceCount do
            safeKeypress(BACKSPACE)
            task.wait(0.025 + math.random() * 0.035)
            safeKeyrelease(BACKSPACE)
            task.wait(0.008 + math.random() * 0.015)
        end
        
        task.wait(pauseBeforeRetype)
        
        lastKey = nil
        for i = 1, #word do
            local c = word:sub(i, i)
            if keys[c] then
                local patternMult = getPatternMultiplier(word, i)
                local distanceWeight = getKeyDistanceWeight(lastKey, c)
                local variation = 0.85 + (math.random() * 0.5)
                
                local delay = baseDelay * 0.9 * patternMult * distanceWeight * variation
                delay = math.max(0.025, math.min(0.08, delay))
                
                safeKeypress(keys[c])
                task.wait(delay + (math.random() * 0.008))
                safeKeyrelease(keys[c])
                task.wait(0.003 + math.random() * 0.005)
                
                lastKey = c
            end
        end
    end
    
    task.wait(0.03 + math.random() * 0.04)
    safeKeypress(ENTER)
    task.wait(0.04 + math.random() * 0.04)
    safeKeyrelease(ENTER)
    
    if hadTypo then
        task.wait(0.1 + math.random() * 0.15)
    end
    
    task.spawn(function()
        task.wait(0.5)
        local new = getfirstletters()
        if new and table.concat(new) == LastLetters then
            Rejected[word] = true
        end
    end)
    return hadTypo
end

