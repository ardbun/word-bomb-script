        keypress(key)
        return true
    elseif presskey then
        presskey(key)
        return true
    end
    return false
end

local function safeKeyrelease(key)
    if keyrelease then
        keyrelease(key)
        return true
    elseif releasekey then
        releasekey(key)
        return true
    end
    return false
end

